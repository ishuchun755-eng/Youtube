[
 {
  "text": "Tasavvur qiling: Paynet shoxobchasidan yangi raqam sotib oldingiz.",
  "start": 0,
  "end": 3.16
 },
 {
  "text": "Telegramdan ro'yxatdan o'tdingiz.",
  "start": 3.39,
  "end": 4.82
 },
 {
  "text": "Lekin bu raqamni oldin kimdir ishlatgan ekan.",
  "start": 5.05,
  "end": 7.25
 },
 {
  "text": "Kripto hamyonni ochsangiz...",
  "start": 7.51,
  "end": 8.83
 },
 {
  "text": "O'nta bitkoin turibdi!",
  "start": 9.08,
  "end": 10.18
 },
 {
  "text": "Qo'llaringiz qaltiray boshlaydi.",
  "start": 10.44,
  "end": 11.88
 },
 {
  "text": "Bitta bitkoin oltmish ming dollar bo'lsa...",
  "start": 12.04,
  "end": 14.09
 },
 {
  "text": "Bu olti yuz ming dollar!",
  "start": 14.34,
  "end": 15.52
 },
 {
  "text": "Qarzlarni uzasiz, uy olasiz, yangi mashina...",
  "start": 15.78,
  "end": 18.27
 },
 {
  "text": "Shu payt Telegramga xabar keladi.",
  "start": 18.55,
  "end": 20.07
 },
 {
  "text": "\"Salom.",
  "start": 20.33,
  "end": 20.68
 },
 {
  "text": "Raqamni yangi oldingizmi?",
  "start": 20.86,
  "end": 21.98
 },
 {
  "text": "Muhim gapim bor.",
  "start": 22.22,
  "end": 22.92
 },
 {
  "text": "Men sizni taniyman...",
  "start": 23.15,
  "end": 23.98
 },
 {
  "text": "Va uyingizni ham bilaman.\"",
  "start": 24.24,
  "end": 25.52
 },
 {
  "text": "Pastida esa...",
  "start": 25.73,
  "end": 26.41
 },
 {
  "text": "Sizning to'liq manzilingiz.",
  "start": 26.53,
  "end": 27.88
 },
 {
  "text": "Ayting-chi, nima qilardingiz?",
  "start": 28.07,
  "end": 29.37
 },
 {
  "text": "Bloklaysizmi yoki javob yozasizmi?",
  "start": 29.55,
  "end": 31.47
 },
 {
  "text": "Izohda yozing.",
  "start": 31.71,
  "end": 32.34
 },
 {
  "text": "Ikkinchi qism tez orada, obuna bo'ling!",
  "start": 32.55,
  "end": 34.65
 }
]