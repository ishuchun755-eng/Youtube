[
 {
  "text": "Tasavvur qiling, siz bir kuni ertalab uyg'onasiz va telefoningizga qaraysiz.",
  "start": 0.0,
  "end": 4.519
 },
 {
  "text": "Soat sakkiz.",
  "start": 4.807,
  "end": 5.662
 },
 {
  "text": "Ammo bugun siz juda g'alati narsani sezasiz.",
  "start": 6.044,
  "end": 8.577
 },
 {
  "text": "Kecha tunda, soat uchda, telefoningiz birdan o'chib qolgan edi.",
  "start": 8.921,
  "end": 12.727
 },
 {
  "text": "Lekin ertalab uni yoqqaningizda, soat uchdan bir daqiqa o'tganini ko'rasiz.",
  "start": 13.143,
  "end": 17.646
 },
 {
  "text": "Siz buni telefonning nosozligi deb o'ylaysiz.",
  "start": 18.025,
  "end": 20.35
 },
 {
  "text": "Ammo kechasi yana uyg'onib ketasiz.",
  "start": 20.746,
  "end": 22.651
 },
 {
  "text": "Soat uch.",
  "start": 22.958,
  "end": 23.638
 },
 {
  "text": "Birdan hamma narsa jim bo'lib qoladi.",
  "start": 24.005,
  "end": 26.069
 },
 {
  "text": "Soat to'xtaydi.",
  "start": 26.42,
  "end": 27.321
 },
 {
  "text": "Ventilyator aylanmay qoladi.",
  "start": 27.625,
  "end": 29.079
 },
 {
  "text": "Deraza ortidagi mashinalar harakatsiz turibdi.",
  "start": 29.383,
  "end": 31.804
 },
 {
  "text": "Faqat siz harakatlana olasiz.",
  "start": 32.174,
  "end": 33.849
 },
 {
  "text": "Jasur ko'chaga chiqadi.",
  "start": 34.231,
  "end": 35.342
 },
 {
  "text": "U yerda hamma narsa muzlab qolgandek.",
  "start": 35.651,
  "end": 37.801
 },
 {
  "text": "Osmonda uchayotgan qush ham bir joyda qotib turibdi.",
  "start": 38.053,
  "end": 40.865
 },
 {
  "text": "Jasur hayratda: \"Bu nima o'zi?",
  "start": 41.207,
  "end": 43.247
 },
 {
  "text": "Men tush ko'ryapmanmi?\"",
  "start": 43.553,
  "end": 44.755
 },
 {
  "text": "U do'kon ichiga kiradi.",
  "start": 45.129,
  "end": 46.268
 },
 {
  "text": "Televizorni yoqishga urinadi, ammo hech narsa ishlamaydi.",
  "start": 46.565,
  "end": 49.864
 },
 {
  "text": "Keyin mashina ichidan pul topib, o'ziga ovqat oladi.",
  "start": 50.178,
  "end": 52.938
 },
 {
  "text": "Soat uchdan bir daqiqa o'tishi bilan birdan hamma narsa yana harakatlana boshlaydi.",
  "start": 53.272,
  "end": 57.992
 },
 {
  "text": "U endi bitta narsani tushundi: har kuni dunyoda hech kim ko'rmaydigan qo'shimcha bir soat bor edi.",
  "start": 58.294,
  "end": 64.099
 },
 {
  "text": "Keyingi kunlarda Jasur bu imkoniyatdan foydalanishni boshlaydi.",
  "start": 64.406,
  "end": 67.659
 },
 {
  "text": "Yigirma beshinchi soatda u shaharni aylanadi, kutubxonada kitob o'qiydi.",
  "start": 67.956,
  "end": 71.735
 },
 {
  "text": "Imtihonlarga ham shu vaqtda tayyorlanadi.",
  "start": 72.032,
  "end": 74.152
 },
 {
  "text": "Bir necha haftada uning hayoti butunlay o'zgaradi: u ko'p narsani o'rganadi va pul ham topadi.",
  "start": 74.429,
  "end": 80.103
 },
 {
  "text": "Ammo bir kuni soat uchda ko'chada ketayotib, uzoqdan bir odamni ko'rib qoladi.",
  "start": 80.442,
  "end": 84.905
 },
 {
  "text": "Bu mumkin emas edi.",
  "start": 85.202,
  "end": 86.227
 },
 {
  "text": "Chunki bu vaqtda butun dunyo muzlab qolardi.",
  "start": 86.511,
  "end": 89.084
 },
 {
  "text": "Jasur o'sha odamning oldiga yuguradi.",
  "start": 89.415,
  "end": 91.324
 },
 {
  "text": "\"Hoy!",
  "start": 91.675,
  "end": 91.994
 },
 {
  "text": "Siz kimsiz?",
  "start": 92.226,
  "end": 92.94
 },
 {
  "text": "Siz ham harakatlana olyapsizmi?\"",
  "start": 93.161,
  "end": 94.709
 },
 {
  "text": "Notanish odam unga qaraydi.",
  "start": 95.035,
  "end": 96.51
 },
 {
  "text": "\"Demak, nihoyat seni ham topdim.\"",
  "start": 96.849,
  "end": 99.124
 },
 {
  "text": "\"Nima?",
  "start": 99.432,
  "end": 99.817
 },
 {
  "text": "Siz meni taniysizmi?\"",
  "start": 100.077,
  "end": 101.142
 },
 {
  "text": "\"Men bu yerda o'n yetti yildan beri yashayman.\"",
  "start": 101.45,
  "end": 103.901
 },
 {
  "text": "Notanish odam davom etadi: \"Sen hali yangi kelgansan.",
  "start": 104.237,
  "end": 107.48
 },
 {
  "text": "Bu soat oddiy sovg'a emas.",
  "start": 107.747,
  "end": 109.576
 },
 {
  "text": "Bu tuzoq.\"",
  "start": 109.802,
  "end": 110.614
 },
 {
  "text": "\"Qanaqa tuzoq?\"",
  "start": 110.897,
  "end": 111.668
 },
 {
  "text": "\"Har safar yigirma beshinchi soatdan foydalanganingda, sening haqiqiy hayotingdan vaqt olib qo'yiladi.\"",
  "start": 111.907,
  "end": 117.558
 },
 {
  "text": "Jasur ishonmaydi.",
  "start": 117.898,
  "end": 118.934
 },
 {
  "text": "\"Unda nega siz bu yerda yuribsiz?\"",
  "start": 119.229,
  "end": 120.82
 },
 {
  "text": "Notanish odam jilmayadi: \"Chunki men ham bir vaqtlar sen kabi edim.\"",
  "start": 121.097,
  "end": 125.401
 },
 {
  "text": "Notanish odam Jasurni eski binoga olib boradi.",
  "start": 125.756,
  "end": 128.425
 },
 {
  "text": "Devorda yuzlab odamlarning suratlari osilgan edi.",
  "start": 128.696,
  "end": 131.502
 },
 {
  "text": "Birdan Jasur bir surat oldida to'xtab qoladi.",
  "start": 131.794,
  "end": 134.282
 },
 {
  "text": "Bu uning o'z surati edi.",
  "start": 134.598,
  "end": 136.149
 },
 {
  "text": "Surat ostida esa yozuv bor: \"Jasur.",
  "start": 136.445,
  "end": 138.117
 },
 {
  "text": "Yigirma beshinchi soatga kirgan sana: o'n to'qqizinchi noyabr.\"",
  "start": 138.458,
  "end": 142.496
 },
 {
  "text": "Jasur qo'rqib ketadi.",
  "start": 142.857,
  "end": 144.018
 },
 {
  "text": "\"Bu qanday bo'lishi mumkin?",
  "start": 144.254,
  "end": 145.511
 },
 {
  "text": "Men bugun birinchi marta keldim-ku!\"",
  "start": 145.724,
  "end": 147.402
 },
 {
  "text": "Notanish odam sekin javob beradi: \"Yo'q, Jasur.",
  "start": 147.671,
  "end": 150.623
 },
 {
  "text": "Sen bu yerga birinchi marta kelmayapsan.\"",
  "start": 150.913,
  "end": 153.155
 },
 {
  "text": "U devordagi boshqa suratni ko'rsatadi.",
  "start": 153.44,
  "end": 155.53
 },
 {
  "text": "Suratda yana Jasur bor edi.",
  "start": 155.872,
  "end": 157.613
 },
 {
  "text": "Lekin suratning sanasi o'n yetti yil oldin edi.",
  "start": 157.953,
  "end": 160.72
 },
 {
  "text": "\"Sen o'n yetti yil oldin ham bu yerga kelgansan.",
  "start": 161.119,
  "end": 163.715
 },
 {
  "text": "Lekin har safar xotirang o'chiriladi.\"",
  "start": 164.047,
  "end": 166.131
 },
 {
  "text": "Jasur ortga chekinadi.",
  "start": 166.486,
  "end": 167.743
 },
 {
  "text": "\"Unda men kimman?\"",
  "start": 168.129,
  "end": 169.429
 },
 {
  "text": "Notanish odam dedi: \"Sen bu yerda qolib ketganlarning oxirgisi emassan.",
  "start": 169.799,
  "end": 174.026
 },
 {
  "text": "Sen bu dunyoni boshqarayotgan odamsan.\"",
  "start": 174.399,
  "end": 176.9
 },
 {
  "text": "Birdan sirena chalinadi.",
  "start": 177.303,
  "end": 178.668
 },
 {
  "text": "Devordagi katta ekranda yozuv paydo bo'ladi: \"Yigirma beshinchi soat yakunlanishiga o'n soniya qoldi.\"",
  "start": 178.954,
  "end": 184.834
 },
 {
  "text": "Notanish odam Jasurning qo'lidan ushlaydi.",
  "start": 185.196,
  "end": 187.404
 },
 {
  "text": "\"Tezroq!",
  "start": 187.699,
  "end": 188.152
 },
 {
  "text": "Bu safar xotirangni o'chirishlariga yo'l qo'yma!\"",
  "start": 188.358,
  "end": 190.608
 },
 {
  "text": "Jasur yuguradi.",
  "start": 190.885,
  "end": 191.803
 },
 {
  "text": "Ammo u birdan to'xtaydi.",
  "start": 192.122,
  "end": 193.666
 },
 {
  "text": "Chunki ekranda yangi yozuv paydo bo'ladi: \"Yangi nazoratchi aniqlandi.\"",
  "start": 194.017,
  "end": 198.448
 },
 {
  "text": "Jasur orqasiga qaraydi.",
  "start": 198.805,
  "end": 200.145
 },
 {
  "text": "Notanish odam esa yo'qolib qolgan edi.",
  "start": 200.514,
  "end": 202.567
 },
 {
  "text": "Shu payt telefoni jiringlaydi.",
  "start": 202.94,
  "end": 204.531
 },
 {
  "text": "Noma'lum raqam.",
  "start": 204.889,
  "end": 205.704
 },
 {
  "text": "Jasur ko'taradi va o'zining ovozini eshitadi: \"Jasur, nihoyat uyg'ondingmi?",
  "start": 206.071,
  "end": 210.993
 },
 {
  "text": "Endi mening o'rnimga sen ishlaysan.\"",
  "start": 211.384,
  "end": 213.456
 }
]