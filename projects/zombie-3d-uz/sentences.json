[
 {
  "text": "Tasavvur qiling: supermarketga bir-ikki narsa olgani kirdingiz.",
  "start": 0.0,
  "end": 3.517
 },
 {
  "text": "O'n besh daqiqada chiqib ketmoqchi edingiz.",
  "start": 3.788,
  "end": 5.735
 },
 {
  "text": "Shu payt tashqarida qichqiriq boshlanadi.",
  "start": 6.017,
  "end": 7.994
 },
 {
  "text": "Avtoturargohda odamlar bir-biriga tashlanyapti.",
  "start": 8.263,
  "end": 10.808
 },
 {
  "text": "Ular urishmayapti...",
  "start": 11.159,
  "end": 12.183
 },
 {
  "text": "Ular tishlashyapti!",
  "start": 12.671,
  "end": 13.967
 },
 {
  "text": "Siz ichkariga yugurasiz, eshiklar ortingizdan yopiladi.",
  "start": 14.311,
  "end": 17.438
 },
 {
  "text": "Endi xavfsizman deb o'ylaysiz.",
  "start": 17.776,
  "end": 19.399
 },
 {
  "text": "Lekin adashasiz.",
  "start": 19.694,
  "end": 20.806
 },
 {
  "text": "Keyingi o'ttiz kun bu supermarket sizning qamoqxonangizga aylanadi.",
  "start": 21.075,
  "end": 24.846
 },
 {
  "text": "Va ichkaridagilarning hammasi ham omon qolmaydi.",
  "start": 25.096,
  "end": 27.849
 },
 {
  "text": "Birinchi kun.",
  "start": 28.443,
  "end": 29.06
 },
 {
  "text": "Ismingiz Sardor.",
  "start": 29.473,
  "end": 30.471
 },
 {
  "text": "Signalizatsiya chalinib ketadi.",
  "start": 30.814,
  "end": 32.264
 },
 {
  "text": "Oynadan qarasangiz, o'nlab yuqumlangan odamlar kimni ko'rsa, o'shani quvlayapti.",
  "start": 32.547,
  "end": 37.034
 },
 {
  "text": "Siz aravachalarni eshik oldiga surasiz, uchta notanish odam kirish joyini to'sishga yordam beradi.",
  "start": 37.317,
  "end": 42.59
 },
 {
  "text": "Ichkarida yana yetti kishi bor.",
  "start": 42.929,
  "end": 44.459
 },
 {
  "text": "Ona va uning kichkina qizi.",
  "start": 44.787,
  "end": 46.368
 },
 {
  "text": "Bir chol.",
  "start": 46.73,
  "end": 47.29
 },
 {
  "text": "Ikki o'smir.",
  "start": 47.616,
  "end": 48.317
 },
 {
  "text": "Do'kon xodimi.",
  "start": 48.619,
  "end": 49.429
 },
 {
  "text": "Va qora kurtkali, indamas bir odam.",
  "start": 49.643,
  "end": 51.938
 },
 {
  "text": "Telefoningizda aloqa yo'q.",
  "start": 52.242,
  "end": 53.648
 },
 {
  "text": "Tashqarida yuzlab yuqumlanganlar binoni o'rab olgan.",
  "start": 53.919,
  "end": 56.882
 },
 {
  "text": "Chiqib ketishning iloji yo'q.",
  "start": 57.205,
  "end": 58.698
 },
 {
  "text": "Uchinchi kun.",
  "start": 59.141,
  "end": 59.732
 },
 {
  "text": "Ovqatni bo'lib chiqasiz.",
  "start": 60.068,
  "end": 61.255
 },
 {
  "text": "Konserva, suv, yorma.",
  "start": 61.509,
  "end": 63.232
 },
 {
  "text": "Avvaliga hamma baham ko'radi.",
  "start": 63.497,
  "end": 65.048
 },
 {
  "text": "Lekin zaxira juda tez tugayapti.",
  "start": 65.28,
  "end": 67.199
 },
 {
  "text": "O'sha kechasi omborxonadan qandaydir tovush eshitasiz.",
  "start": 67.472,
  "end": 70.386
 },
 {
  "text": "Polda bo'm-bo'sh qutilar.",
  "start": 70.653,
  "end": 72.002
 },
 {
  "text": "Kimdir ovqat o'g'irlayapti.",
  "start": 72.316,
  "end": 73.686
 },
 {
  "text": "Keyin eshikda qonli qo'l izini ko'rasiz.",
  "start": 73.948,
  "end": 76.27
 },
 {
  "text": "Va eshikning narigi tomonidan kimdir taqillatadi.",
  "start": 76.493,
  "end": 79.126
 },
 {
  "text": "Yettinchi kun.",
  "start": 79.578,
  "end": 80.285
 },
 {
  "text": "Xodim o'smirlardan biri yengi ostida tishlangan joyni yashirayotganini sezib qoladi.",
  "start": 80.617,
  "end": 85.122
 },
 {
  "text": "U yuqumlangan.",
  "start": 85.391,
  "end": 86.345
 },
 {
  "text": "Qora kurtkali odam temir kaltakni qo'liga oladi.",
  "start": 86.661,
  "end": 89.24
 },
 {
  "text": "Bola yalinadi.",
  "start": 89.516,
  "end": 90.394
 },
 {
  "text": "U ukasini qutqarayotganda tishlangan ekan.",
  "start": 90.677,
  "end": 92.939
 },
 {
  "text": "Siz qaror qilishingiz kerak.",
  "start": 93.237,
  "end": 94.62
 },
 {
  "text": "Uni himoya qilasizmi yoki hammani?",
  "start": 94.916,
  "end": 97.079
 },
 {
  "text": "Hech kim javob berishga ulgurmay, bola cholga tashlanadi.",
  "start": 97.399,
  "end": 100.313
 },
 {
  "text": "To'polon!",
  "start": 100.6,
  "end": 101.158
 },
 {
  "text": "Siz qizchani chetga tortib olasiz.",
  "start": 101.454,
  "end": 103.251
 },
 {
  "text": "Endi xavf ichkarida.",
  "start": 103.509,
  "end": 104.894
 },
 {
  "text": "O'ninchi kun.",
  "start": 105.343,
  "end": 105.943
 },
 {
  "text": "Yuqumlangan bola omborxonaga qamab qo'yilgan.",
  "start": 106.232,
  "end": 108.625
 },
 {
  "text": "Lekin tashqaridagi to'da kirish joyini topib oldi.",
  "start": 108.874,
  "end": 111.469
 },
 {
  "text": "Har kecha ular oynani urishadi.",
  "start": 111.721,
  "end": 113.333
 },
 {
  "text": "Barrikada yorilib boryapti.",
  "start": 113.577,
  "end": 115.087
 },
 {
  "text": "Siz ovqatni do'kon tepasidagi ofisga olib chiqasiz va favqulodda chiqish eshigini topasiz.",
  "start": 115.355,
  "end": 120.397
 },
 {
  "text": "U to'g'ri avtoturargohga olib chiqadi.",
  "start": 120.62,
  "end": 122.637
 },
 {
  "text": "Yuqumlanganlarga to'la.",
  "start": 122.89,
  "end": 124.199
 },
 {
  "text": "Siz kutasiz.",
  "start": 124.521,
  "end": 125.394
 },
 {
  "text": "O'n beshinchi kun.",
  "start": 125.817,
  "end": 126.578
 },
 {
  "text": "Yarim tunda hamma chiroq o'chadi.",
  "start": 126.846,
  "end": 128.614
 },
 {
  "text": "Muzlatgichlar jim bo'lib qoladi.",
  "start": 128.878,
  "end": 130.465
 },
 {
  "text": "Qizil favqulodda chiroqlar miltillay boshlaydi.",
  "start": 130.709,
  "end": 133.156
 },
 {
  "text": "Javonlar orasida qadam tovushlarini eshitasiz.",
  "start": 133.387,
  "end": 135.817
 },
 {
  "text": "Qorong'ida bir soya lip etib o'tadi.",
  "start": 136.032,
  "end": 138.095
 },
 {
  "text": "Ulardan biri yuk tushirish eshigidan kirib olgan.",
  "start": 138.333,
  "end": 140.689
 },
 {
  "text": "U qora kurtkali odamga tashlanadi.",
  "start": 140.965,
  "end": 142.894
 },
 {
  "text": "Siz yuk eshigini taqa yopasiz.",
  "start": 143.14,
  "end": 145.008
 },
 {
  "text": "Orqangizga o'girilsangiz, u yo'q.",
  "start": 145.261,
  "end": 147.297
 },
 {
  "text": "Yigirma birinchi kun.",
  "start": 147.741,
  "end": 148.678
 },
 {
  "text": "Ovqat deyarli tugadi.",
  "start": 148.933,
  "end": 150.233
 },
 {
  "text": "Ona va qizi tobora holsizlanmoqda.",
  "start": 150.51,
  "end": 152.622
 },
 {
  "text": "Favqulodda chiqish eshigiga borasiz va qotib qolasiz.",
  "start": 152.956,
  "end": 156.097
 },
 {
  "text": "Qora kurtkali odam tirik!",
  "start": 156.457,
  "end": 157.833
 },
 {
  "text": "U texnik tunnellarda ratsiya bilan yashiringan ekan.",
  "start": 158.128,
  "end": 160.632
 },
 {
  "text": "Shahar tashqarisida harbiylarning qutqaruv punkti bor.",
  "start": 160.952,
  "end": 163.546
 },
 {
  "text": "Ikki kundan keyin vertolyotlar keladi.",
  "start": 163.893,
  "end": 165.635
 },
 {
  "text": "Lekin uning aytishicha, faqat uch kishiga joy bor.",
  "start": 165.986,
  "end": 168.402
 },
 {
  "text": "Shu payt bino gumburlab silkinadi.",
  "start": 168.784,
  "end": 170.75
 },
 {
  "text": "Old eshiklar qulab tushdi.",
  "start": 171.075,
  "end": 172.433
 },
 {
  "text": "Boshqa vaqt qolmadi.",
  "start": 172.712,
  "end": 173.711
 },
 {
  "text": "O'ttizinchi kun.",
  "start": 174.116,
  "end": 174.89
 },
 {
  "text": "Favqulodda chiqish eshigini ochasiz.",
  "start": 175.209,
  "end": 177.003
 },
 {
  "text": "Avtoturargoh tashlab ketilgan mashinalarga to'la, yuqumlanganlar esa hamma yoqda.",
  "start": 177.279,
  "end": 181.832
 },
 {
  "text": "Qizchaning qo'lidan ushlab yuguring!",
  "start": 182.118,
  "end": 183.578
 },
 {
  "text": "Ulardan biri sizni ko'rib qoladi.",
  "start": 183.887,
  "end": 185.349
 },
 {
  "text": "Keyin o'ntasi.",
  "start": 185.656,
  "end": 186.636
 },
 {
  "text": "Siz bo'sh yuk mashinasigacha yetib borasiz.",
  "start": 186.93,
  "end": 189.233
 },
 {
  "text": "Xodim uni o't oldiradi.",
  "start": 189.537,
  "end": 190.854
 },
 {
  "text": "Hamma ichkariga chiqadi va siz uchib ketasiz.",
  "start": 191.232,
  "end": 193.908
 },
 {
  "text": "Bir oyda birinchi marta o'zingizni ozod his qilasiz.",
  "start": 194.135,
  "end": 197.163
 },
 {
  "text": "Keyin ratsiya shitirlaydi.",
  "start": 197.445,
  "end": 198.825
 },
 {
  "text": "\"Barcha evakuatsiya markazlari qo'ldan ketdi.",
  "start": 199.093,
  "end": 201.385
 },
 {
  "text": "Harbiy bazaga yaqinlashmang.\"",
  "start": 201.595,
  "end": 203.087
 },
 {
  "text": "Qizcha shivirlaydi: \"Endi xavfsizmizmi?\"",
  "start": 203.381,
  "end": 205.597
 },
 {
  "text": "Siz javob bermaysiz.",
  "start": 205.894,
  "end": 207.248
 },
 {
  "text": "Chunki xodim orqada jimgina bilagini ushlab o'tiribdi.",
  "start": 207.54,
  "end": 210.629
 },
 {
  "text": "Va u yerda yangi tishlangan iz bor.",
  "start": 210.976,
  "end": 213.214
 },
 {
  "text": "Siz o'ttiz kun omon qoldingiz.",
  "start": 213.641,
  "end": 215.616
 },
 {
  "text": "Qizchani qutqardingiz.",
  "start": 215.884,
  "end": 216.979
 },
 {
  "text": "Lekin endi guruhingizdagi kimdir yuqumlangan.",
  "start": 217.26,
  "end": 220.01
 },
 {
  "text": "Uni tashlab ketarmidingiz?",
  "start": 220.371,
  "end": 221.63
 },
 {
  "text": "Va siz qancha omon qolgan bo'lardingiz?",
  "start": 221.904,
  "end": 224.11
 },
 {
  "text": "Izohlarda yozing va yangi hikoyalar uchun obuna bo'ling.",
  "start": 224.43,
  "end": 227.971
 }
]