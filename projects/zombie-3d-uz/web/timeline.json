{"S": [{"text": "Tasavvur qiling: supermarketga bir-ikki narsa olgani kirdingiz.", "start": 0.0, "end": 3.517}, {"text": "O'n besh daqiqada chiqib ketmoqchi edingiz.", "start": 3.788, "end": 5.735}, {"text": "Shu payt tashqarida qichqiriq boshlanadi.", "start": 6.017, "end": 7.994}, {"text": "Avtoturargohda odamlar bir-biriga tashlanyapti.", "start": 8.263, "end": 10.808}, {"text": "Ular urishmayapti...", "start": 11.159, "end": 12.183}, {"text": "Ular tishlashyapti!", "start": 12.671, "end": 13.967}, {"text": "Siz ichkariga yugurasiz, eshiklar ortingizdan yopiladi.", "start": 14.311, "end": 17.438}, {"text": "Endi xavfsizman deb o'ylaysiz.", "start": 17.776, "end": 19.399}, {"text": "Lekin adashasiz.", "start": 19.694, "end": 20.806}, {"text": "Keyingi o'ttiz kun bu supermarket sizning qamoqxonangizga aylanadi.", "start": 21.075, "end": 24.846}, {"text": "Va ichkaridagilarning hammasi ham omon qolmaydi.", "start": 25.096, "end": 27.849}, {"text": "Birinchi kun.", "start": 28.443, "end": 29.06}, {"text": "Ismingiz Sardor.", "start": 29.473, "end": 30.471}, {"text": "Signalizatsiya chalinib ketadi.", "start": 30.814, "end": 32.264}, {"text": "Oynadan qarasangiz, o'nlab yuqumlangan odamlar kimni ko'rsa, o'shani quvlayapti.", "start": 32.547, "end": 37.034}, {"text": "Siz aravachalarni eshik oldiga surasiz, uchta notanish odam kirish joyini to'sishga yordam beradi.", "start": 37.317, "end": 42.59}, {"text": "Ichkarida yana yetti kishi bor.", "start": 42.929, "end": 44.459}, {"text": "Ona va uning kichkina qizi.", "start": 44.787, "end": 46.368}, {"text": "Bir chol.", "start": 46.73, "end": 47.29}, {"text": "Ikki o'smir.", "start": 47.616, "end": 48.317}, {"text": "Do'kon xodimi.", "start": 48.619, "end": 49.429}, {"text": "Va qora kurtkali, indamas bir odam.", "start": 49.643, "end": 51.938}, {"text": "Telefoningizda aloqa yo'q.", "start": 52.242, "end": 53.648}, {"text": "Tashqarida yuzlab yuqumlanganlar binoni o'rab olgan.", "start": 53.919, "end": 56.882}, {"text": "Chiqib ketishning iloji yo'q.", "start": 57.205, "end": 58.698}, {"text": "Uchinchi kun.", "start": 59.141, "end": 59.732}, {"text": "Ovqatni bo'lib chiqasiz.", "start": 60.068, "end": 61.255}, {"text": "Konserva, suv, yorma.", "start": 61.509, "end": 63.232}, {"text": "Avvaliga hamma baham ko'radi.", "start": 63.497, "end": 65.048}, {"text": "Lekin zaxira juda tez tugayapti.", "start": 65.28, "end": 67.199}, {"text": "O'sha kechasi omborxonadan qandaydir tovush eshitasiz.", "start": 67.472, "end": 70.386}, {"text": "Polda bo'm-bo'sh qutilar.", "start": 70.653, "end": 72.002}, {"text": "Kimdir ovqat o'g'irlayapti.", "start": 72.316, "end": 73.686}, {"text": "Keyin eshikda qonli qo'l izini ko'rasiz.", "start": 73.948, "end": 76.27}, {"text": "Va eshikning narigi tomonidan kimdir taqillatadi.", "start": 76.493, "end": 79.126}, {"text": "Yettinchi kun.", "start": 79.578, "end": 80.285}, {"text": "Xodim o'smirlardan biri yengi ostida tishlangan joyni yashirayotganini sezib qoladi.", "start": 80.617, "end": 85.122}, {"text": "U yuqumlangan.", "start": 85.391, "end": 86.345}, {"text": "Qora kurtkali odam temir kaltakni qo'liga oladi.", "start": 86.661, "end": 89.24}, {"text": "Bola yalinadi.", "start": 89.516, "end": 90.394}, {"text": "U ukasini qutqarayotganda tishlangan ekan.", "start": 90.677, "end": 92.939}, {"text": "Siz qaror qilishingiz kerak.", "start": 93.237, "end": 94.62}, {"text": "Uni himoya qilasizmi yoki hammani?", "start": 94.916, "end": 97.079}, {"text": "Hech kim javob berishga ulgurmay, bola cholga tashlanadi.", "start": 97.399, "end": 100.313}, {"text": "To'polon!", "start": 100.6, "end": 101.158}, {"text": "Siz qizchani chetga tortib olasiz.", "start": 101.454, "end": 103.251}, {"text": "Endi xavf ichkarida.", "start": 103.509, "end": 104.894}, {"text": "O'ninchi kun.", "start": 127.343, "end": 127.943}, {"text": "Yuqumlangan bola omborxonaga qamab qo'yilgan.", "start": 128.232, "end": 130.625}, {"text": "Lekin tashqaridagi to'da kirish joyini topib oldi.", "start": 130.874, "end": 133.469}, {"text": "Har kecha ular oynani urishadi.", "start": 133.721, "end": 135.333}, {"text": "Barrikada yorilib boryapti.", "start": 135.577, "end": 137.087}, {"text": "Siz ovqatni do'kon tepasidagi ofisga olib chiqasiz va favqulodda chiqish eshigini topasiz.", "start": 137.35500000000002, "end": 142.397}, {"text": "U to'g'ri avtoturargohga olib chiqadi.", "start": 142.62, "end": 144.637}, {"text": "Yuqumlanganlarga to'la.", "start": 144.89, "end": 146.199}, {"text": "Siz kutasiz.", "start": 146.52100000000002, "end": 147.394}, {"text": "O'n beshinchi kun.", "start": 147.817, "end": 148.578}, {"text": "Yarim tunda hamma chiroq o'chadi.", "start": 148.846, "end": 150.614}, {"text": "Muzlatgichlar jim bo'lib qoladi.", "start": 150.878, "end": 152.465}, {"text": "Qizil favqulodda chiroqlar miltillay boshlaydi.", "start": 152.709, "end": 155.156}, {"text": "Javonlar orasida qadam tovushlarini eshitasiz.", "start": 155.387, "end": 157.817}, {"text": "Qorong'ida bir soya lip etib o'tadi.", "start": 158.032, "end": 160.095}, {"text": "Ulardan biri yuk tushirish eshigidan kirib olgan.", "start": 160.333, "end": 162.689}, {"text": "U qora kurtkali odamga tashlanadi.", "start": 162.965, "end": 164.894}, {"text": "Siz yuk eshigini taqa yopasiz.", "start": 165.14, "end": 167.008}, {"text": "Orqangizga o'girilsangiz, u yo'q.", "start": 167.261, "end": 169.297}, {"text": "Yigirma birinchi kun.", "start": 169.741, "end": 170.678}, {"text": "Ovqat deyarli tugadi.", "start": 170.933, "end": 172.233}, {"text": "Ona va qizi tobora holsizlanmoqda.", "start": 172.51, "end": 174.622}, {"text": "Favqulodda chiqish eshigiga borasiz va qotib qolasiz.", "start": 174.956, "end": 178.097}, {"text": "Qora kurtkali odam tirik!", "start": 178.457, "end": 179.833}, {"text": "U texnik tunnellarda ratsiya bilan yashiringan ekan.", "start": 180.128, "end": 182.632}, {"text": "Shahar tashqarisida harbiylarning qutqaruv punkti bor.", "start": 182.952, "end": 185.546}, {"text": "Ikki kundan keyin vertolyotlar keladi.", "start": 185.893, "end": 187.635}, {"text": "Lekin uning aytishicha, faqat uch kishiga joy bor.", "start": 187.986, "end": 190.402}, {"text": "Shu payt bino gumburlab silkinadi.", "start": 190.784, "end": 192.75}, {"text": "Old eshiklar qulab tushdi.", "start": 193.075, "end": 194.433}, {"text": "Boshqa vaqt qolmadi.", "start": 194.712, "end": 195.711}, {"text": "O'ttizinchi kun.", "start": 196.116, "end": 196.89}, {"text": "Favqulodda chiqish eshigini ochasiz.", "start": 197.209, "end": 199.003}, {"text": "Avtoturargoh tashlab ketilgan mashinalarga to'la, yuqumlanganlar esa hamma yoqda.", "start": 199.279, "end": 203.832}, {"text": "Qizchaning qo'lidan ushlab yuguring!", "start": 204.118, "end": 205.578}, {"text": "Ulardan biri sizni ko'rib qoladi.", "start": 205.887, "end": 207.349}, {"text": "Keyin o'ntasi.", "start": 207.656, "end": 208.636}, {"text": "Siz bo'sh yuk mashinasigacha yetib borasiz.", "start": 208.93, "end": 211.233}, {"text": "Xodim uni o't oldiradi.", "start": 211.537, "end": 212.854}, {"text": "Hamma ichkariga chiqadi va siz uchib ketasiz.", "start": 213.232, "end": 215.908}, {"text": "Bir oyda birinchi marta o'zingizni ozod his qilasiz.", "start": 216.135, "end": 219.163}, {"text": "Keyin ratsiya shitirlaydi.", "start": 219.445, "end": 220.825}, {"text": "\"Barcha evakuatsiya markazlari qo'ldan ketdi.", "start": 221.093, "end": 223.385}, {"text": "Harbiy bazaga yaqinlashmang.\"", "start": 223.595, "end": 225.087}, {"text": "Qizcha shivirlaydi: \"Endi xavfsizmizmi?\"", "start": 225.381, "end": 227.597}, {"text": "Siz javob bermaysiz.", "start": 227.894, "end": 229.248}, {"text": "Chunki xodim orqada jimgina bilagini ushlab o'tiribdi.", "start": 229.54, "end": 232.629}, {"text": "Va u yerda yangi tishlangan iz bor.", "start": 232.976, "end": 235.214}, {"text": "Siz o'ttiz kun omon qoldingiz.", "start": 235.641, "end": 237.616}, {"text": "Qizchani qutqardingiz.", "start": 237.884, "end": 238.979}, {"text": "Lekin endi guruhingizdagi kimdir yuqumlangan.", "start": 239.26, "end": 242.01}, {"text": "Uni tashlab ketarmidingiz?", "start": 242.371, "end": 243.63}, {"text": "Va siz qancha omon qolgan bo'lardingiz?", "start": 243.904, "end": 246.11}, {"text": "Izohlarda yozing va yangi hikoyalar uchun obuna bo'ling.", "start": 246.43, "end": 249.971}], "GAP": 22.0, "CUT": 105.144}