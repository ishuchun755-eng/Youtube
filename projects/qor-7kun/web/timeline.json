{
"S": [
{
"text": "Tasavvur qiling: siz va ikki do'stingiz qishda qishloqqa, to'yga ketyapsiz.",
"start": 0.0,
"end": 4.186
},
{
"text": "Navigator qisqa yo'l ko'rsatadi: o'rmon orqali.",
"start": 4.422,
"end": 7.107
},
{
"text": "\"Bir soat tejaymiz\", deydi Bekzod.",
"start": 7.388,
"end": 9.284
},
{
"text": "Siz rozi bo'lasiz.",
"start": 9.512,
"end": 10.523
},
{
"text": "Bu hayotingizdagi eng katta xato bo'ladi.",
"start": 10.736,
"end": 13.117
},
{
"text": "Chunki keyingi yetti kun bu mashina siz uchun ham uy, ham qamoqxonaga aylanadi.",
"start": 13.359,
"end": 18.1
},
{
"text": "Tashqarida esa minus o'ttiz daraja sovuq.",
"start": 18.359,
"end": 20.948
},
{
"text": "Birinchi kun.",
"start": 21.466,
"end": 22.107
},
{
"text": "Ismingiz Sardor.",
"start": 22.442,
"end": 23.345
},
{
"text": "Mashinani siz haydayapsiz, yonda Bekzod, orqada Otabek.",
"start": 23.625,
"end": 27.123
},
{
"text": "O'rmon ichida yo'l torayib boradi.",
"start": 27.351,
"end": 28.995
},
{
"text": "Qor kuchayadi.",
"start": 29.23,
"end": 29.928
},
{
"text": "Yo'lda bitta ham mashina yo'q.",
"start": 30.172,
"end": 31.714
},
{
"text": "Navigator butun yo'l davomida ishlab, telefoningiz zaryadini yeb qo'ydi.",
"start": 31.933,
"end": 35.681
},
{
"text": "Ekranda bir foiz...",
"start": 35.948,
"end": 37.128
},
{
"text": "Va telefon o'chadi.",
"start": 37.399,
"end": 38.54
},
{
"text": "\"Bekzod, navigatorni och!\"",
"start": 38.788,
"end": 40.194
},
{
"text": "Bekzodning telefonida signal yo'q, zaryad ellik foiz, xolos.",
"start": 40.481,
"end": 44.111
},
{
"text": "Otabek cho'ntaklarini kovlaydi va qotib qoladi: telefoni uyda, zaryadkada qolgan.",
"start": 44.361,
"end": 49.012
},
{
"text": "Endi qaysi tomonga ketayotganingizni hech kim bilmaydi.",
"start": 49.271,
"end": 52.159
},
{
"text": "Burilishda mashina qorda sirpanadi.",
"start": 52.392,
"end": 54.305
},
{
"text": "Rul ishlamaydi.",
"start": 54.532,
"end": 55.406
},
{
"text": "Mashina pastlikka tushib, qalin qorga botib qoladi.",
"start": 55.623,
"end": 58.283
},
{
"text": "Otabek eshikni ochadi.",
"start": 58.572,
"end": 59.746
},
{
"text": "Sovuq yuzga pichoqdek uriladi.",
"start": 59.952,
"end": 61.718
},
{
"text": "U bir soniya ham chiday olmay, eshikni qarsillatib yopadi.",
"start": 61.965,
"end": 65.092
},
{
"text": "Termometrda minus yigirma yetti.",
"start": 65.374,
"end": 67.306
},
{
"text": "Siz tez hisoblaysiz.",
"start": 67.632,
"end": 68.839
},
{
"text": "Benzin yarim bak.",
"start": 69.016,
"end": 70.077
},
{
"text": "Mashinani o'chirsangiz, bir soatda ichkari muzlaydi.",
"start": 70.303,
"end": 72.943
},
{
"text": "To'xtovsiz yoqib qo'ysangiz, benzin bir kunda tugaydi.",
"start": 73.151,
"end": 76.023
},
{
"text": "Yo'li bitta: har soatda o'n besh daqiqa motorni yoqib, isinib olish.",
"start": 76.244,
"end": 80.392
},
{
"text": "Ovqatni hisoblaysiz: ikkita non, uchta shokolad, bir termos choy va bir paket pista.",
"start": 80.607,
"end": 85.721
},
{
"text": "Uch kishiga.",
"start": 86.026,
"end": 86.537
},
{
"text": "Kechasi o'rmondan qandaydir uvillash eshitiladi.",
"start": 86.828,
"end": 89.339
},
{
"text": "Birinchi tun eng uzun tun bo'ladi.",
"start": 90.29,
"end": 92.431
},
{
"text": "Soat ikkida tepadan qisirlagan tovush keladi.",
"start": 92.697,
"end": 95.398
},
{
"text": "Mashina tomi qor og'irligidan ichkariga sal egilgan.",
"start": 95.77,
"end": 98.674
},
{
"text": "Bekzod qo'rqib ketadi: \"Tom bosib qolsa-chi?\"",
"start": 99.039,
"end": 101.712
},
{
"text": "Siz eshikni sal ochib, qo'lingiz bilan tomdagi qorni itarib tushirasiz.",
"start": 102.111,
"end": 105.974
},
{
"text": "Qor yerga gup etib tushadi.",
"start": 106.249,
"end": 107.706
},
{
"text": "Ichkariga qaytganingizda, qo'llaringiz qip-qizil, barmoqlaringiz igna sanchilgandek og'riydi.",
"start": 108.012,
"end": 113.167
},
{
"text": "Hech kim uxlamaydi.",
"start": 113.481,
"end": 114.5
},
{
"text": "Hamma faqat bitta narsani o'ylaydi: ertaga bizni kimdir topadimi?",
"start": 114.841,
"end": 118.893
},
{
"text": "Ikkinchi kun.",
"start": 120.081,
"end": 120.755
},
{
"text": "Ertalab Otabekning boshi qattiq og'riydi.",
"start": 121.138,
"end": 123.387
},
{
"text": "Ko'ngli ayniydi, ko'zlari yumilib ketyapti.",
"start": 123.611,
"end": 126.078
},
{
"text": "Bekzod ham esnayveradi.",
"start": 126.304,
"end": 127.557
},
{
"text": "Siz birdan tushunib qolasiz va sovuq ter bosadi.",
"start": 127.811,
"end": 130.474
},
{
"text": "Tutun quvuri qor ostida qolgan!",
"start": 130.717,
"end": 132.62
},
{
"text": "Motor ishlaganda is gazi mashina ichiga kirayapti.",
"start": 132.867,
"end": 135.516
},
{
"text": "Is gazining rangi ham, hidi ham yo'q.",
"start": 135.768,
"end": 137.905
},
{
"text": "Odamni uxlatib qo'yadi...",
"start": 138.119,
"end": 139.344
},
{
"text": "Va qaytib uyg'onmaydi.",
"start": 139.651,
"end": 140.945
},
{
"text": "Siz oynani ochib, tashqariga sakraysiz va qo'lingiz bilan quvur atrofidagi qorni kovlaysiz.",
"start": 141.188,
"end": 145.992
},
{
"text": "Barmoqlaringiz sezmay qoladi.",
"start": 146.214,
"end": 147.712
},
{
"text": "Lekin ulgurdingiz.",
"start": 147.975,
"end": 149.129
},
{
"text": "Shundan keyin qoida bitta: motor yoqilganda oyna sal ochiq turadi, quvur esa har soatda tozalanadi.",
"start": 149.35,
"end": 155.532
},
{
"text": "Uchinchi kun.",
"start": 156.084,
"end": 156.709
},
{
"text": "Choy tugadi.",
"start": 157.105,
"end": 157.725
},
{
"text": "Suvsizlik ochlikdan ham tezroq o'ldiradi.",
"start": 157.966,
"end": 160.29
},
{
"text": "Qorni to'g'ridan-to'g'ri yeb bo'lmaydi: tana issiqligini o'g'irlaydi.",
"start": 160.506,
"end": 164.036
},
{
"text": "Siz bo'sh termosga qor solib, uni pechka teshigi oldiga qo'yasiz.",
"start": 164.289,
"end": 167.853
},
{
"text": "Qor sekin eriydi.",
"start": 168.055,
"end": 169.225
},
{
"text": "Bitta qopqoq suvni uchalangiz bo'lishib ichasiz.",
"start": 169.445,
"end": 172.089
},
{
"text": "Kechasi mashina chiroqlarini bir soniyaga yoqasiz.",
"start": 172.317,
"end": 174.838
},
{
"text": "Daraxtlar orasida ikki juft yashil ko'z yiltiraydi.",
"start": 175.009,
"end": 177.828
},
{
"text": "Bo'rilar.",
"start": 178.087,
"end": 178.622
},
{
"text": "Ular sizni kuzatyapti.",
"start": 178.876,
"end": 180.116
},
{
"text": "Bir soatdan keyin mashina orqasida qor g'irchillaydi.",
"start": 181.143,
"end": 184.094
},
{
"text": "Kimdir aylanib yuribdi.",
"start": 184.492,
"end": 185.685
},
{
"text": "Keyin eshikka nimadir tirnaladi.",
"start": 186.132,
"end": 187.993
},
{
"text": "Otabek pichirlaydi: \"Ular ovqat hidini sezdi.\"",
"start": 188.442,
"end": 191.387
},
{
"text": "Siz qo'lingizni signal tugmasiga qo'yasiz va bor kuchingiz bilan bosasiz.",
"start": 191.775,
"end": 195.891
},
{
"text": "Signal o'rmonni yorib yuboradi.",
"start": 196.288,
"end": 198.067
},
{
"text": "Faralarni yoqasiz.",
"start": 198.429,
"end": 199.413
},
{
"text": "Yashil ko'zlar ortga tisarilib, daraxtlar orasiga g'oyib bo'ladi.",
"start": 199.73,
"end": 203.25
},
{
"text": "Lekin siz bilasiz: ular uzoqqa ketmadi.",
"start": 203.623,
"end": 206.172
},
{
"text": "Endi har kecha bitta odam navbatchilik qiladi.",
"start": 206.577,
"end": 209.053
},
{
"text": "Ayting-chi, siz bo'lganingizda bo'rilar oldida nima qilardingiz?",
"start": 209.473,
"end": 213.293
},
{
"text": "Izohda yozib qoldiring, keyin davom etamiz.",
"start": 213.65,
"end": 216.101
},
{
"text": "To'rtinchi kun.",
"start": 217.004,
"end": 217.741
},
{
"text": "Otabek chidamaydi.",
"start": 218.097,
"end": 219.172
},
{
"text": "\"Shu yerda o'tirsak o'lamiz!",
"start": 219.485,
"end": 222.292
},
{
"text": "Men yo'l topib kelaman!\"",
"start": 222.694,
"end": 224.247
},
{
"text": "Siz uni to'xtatmoqchi bo'lasiz.",
"start": 224.471,
"end": 227.312
},
{
"text": "Lekin u kurtkasini tortib, qor ichiga chiqib ketadi.",
"start": 227.572,
"end": 229.302
},
{
"text": "Bir soat o'tadi.",
"start": 229.557,
"end": 231.012
},
{
"text": "Ikki soat.",
"start": 231.362,
"end": 233.107
},
{
"text": "Qor izlarini ko'mib yuboradi.",
"start": 233.451,
"end": 234.391
},
{
"text": "Uchinchi soatda eshik taqillaydi.",
"start": 234.689,
"end": 236.402
},
{
"text": "Otabek qaytdi!",
"start": 236.639,
"end": 237.705
},
{
"text": "Lekin barmoqlari oqarib ketgan, labi ko'karib qolgan.",
"start": 237.981,
"end": 240.767
},
{
"text": "Siz uning qo'llarini qo'ltig'ingiz ostiga olib isitasiz.",
"start": 241.02,
"end": 243.998
},
{
"text": "Issiq suvga solish mumkin emas, faqat tana issiqligi bilan.",
"start": 244.224,
"end": 245.599
},
{
"text": "Otabek titrab shivirlaydi: \"Hamma tomon bir xil...",
"start": 245.863,
"end": 247.071
},
{
"text": "Daraxtlar...",
"start": 247.627,
"end": 248.314
},
{
"text": "Daraxtlar tugamaydi...\"",
"start": 248.826,
"end": 250.062
},
{
"text": "O'sha kechasi oxirgi shokoladni kim yeyishi bo'yicha janjal chiqadi.",
"start": 251.014,
"end": 254.612
},
{
"text": "Bekzod: \"Men eng kam yedim!\"",
"start": 255.028,
"end": 256.916
},
{
"text": "Otabek: \"Men sizlar uchun qor ichida yurdim!\"",
"start": 257.203,
"end": 259.711
},
{
"text": "Ovozlar balandlashadi.",
"start": 260.002,
"end": 261.207
},
{
"text": "Sovuq va ochlik odamni o'zgartirib qo'yadi.",
"start": 261.486,
"end": 263.847
},
{
"text": "Siz shokoladni olib, uchga bo'lasiz.",
"start": 264.167,
"end": 265.99
},
{
"text": "\"Biz bir-birimizga dushman emasmiz.",
"start": 266.259,
"end": 267.993
},
{
"text": "Bizning dushmanimiz tashqarida.",
"start": 268.332,
"end": 269.878
},
{
"text": "Sovuq.\"",
"start": 270.264,
"end": 270.764
},
{
"text": "Hamma jim bo'lib qoladi.",
"start": 271.154,
"end": 272.433
},
{
"text": "Kichkina bir bo'lak shokolad...",
"start": 272.832,
"end": 274.282
},
{
"text": "Lekin o'sha kechasi u sizlarni yana bir oila qilib qo'yadi.",
"start": 274.775,
"end": 278.811
},
{
"text": "Beshinchi kun.",
"start": 279.995,
"end": 280.672
},
{
"text": "Ertalab motor xirillab, keyin o'chib qoladi.",
"start": 280.984,
"end": 283.418
},
{
"text": "Benzin tugadi.",
"start": 283.681,
"end": 284.447
},
{
"text": "Endi isitish yo'q.",
"start": 284.737,
"end": 285.926
},
{
"text": "Mashina ichi tezda tashqaridek sovib boradi.",
"start": 286.183,
"end": 288.458
},
{
"text": "Siz uchalangiz bitta joyga zich o'tirasiz.",
"start": 288.724,
"end": 290.99
},
{
"text": "Hamma kiyimlar, o'rindiq g'iloflari, gilamchalar ustingizga o'raladi.",
"start": 291.207,
"end": 295.055
},
{
"text": "Uxlab qolmaslik uchun gaplashib o'tirasiz: oilangiz, onangizning oshi, uydagi issiq pechka haqida.",
"start": 295.295,
"end": 300.92
},
{
"text": "Bekzod birdan jim bo'lib qoladi.",
"start": 301.158,
"end": 302.869
},
{
"text": "\"Bekzod?",
"start": 303.156,
"end": 303.575
},
{
"text": "Bekzod!\"",
"start": 303.927,
"end": 304.416
},
{
"text": "Siz uni silkitasiz.",
"start": 304.745,
"end": 305.853
},
{
"text": "U zo'rg'a ko'zini ochadi.",
"start": 306.12,
"end": 307.377
},
{
"text": "Yarim tunda uzoqdan motor ovozi eshitiladi.",
"start": 308.344,
"end": 310.743
},
{
"text": "Uchalangiz ham sakrab turasiz.",
"start": 311.054,
"end": 312.471
},
{
"text": "\"Mashina!",
"start": 312.807,
"end": 313.295
},
{
"text": "Mashina keldi!\"",
"start": 313.548,
"end": 314.304
},
{
"text": "Siz faralarni yoqib-o'chirasiz, signal chalasiz, qichqirasiz.",
"start": 314.755,
"end": 318.425
},
{
"text": "Ovoz yaqinlashadi...",
"start": 318.775,
"end": 319.848
},
{
"text": "Yaqinlashadi...",
"start": 320.467,
"end": 321.339
},
{
"text": "Keyin asta-sekin uzoqlashib, butunlay yo'qoladi.",
"start": 321.829,
"end": 324.697
},
{
"text": "Kimdir katta yo'ldan o'tib ketdi.",
"start": 325.136,
"end": 326.734
},
{
"text": "Sizni ko'rmadi.",
"start": 327.102,
"end": 327.826
},
{
"text": "Bu yetti kun ichidagi eng og'ir lahza bo'ladi.",
"start": 328.273,
"end": 331.082
},
{
"text": "Chunki umid paydo bo'lib, yana g'oyib bo'lishi sovuqdan ham og'irroq.",
"start": 331.429,
"end": 335.587
},
{
"text": "Oltinchi kun.",
"start": 336.792,
"end": 337.439
},
{
"text": "Bekzodning telefonida uch foiz zaryad qolgan.",
"start": 337.694,
"end": 340.074
},
{
"text": "Oxirgi umid shu.",
"start": 340.343,
"end": 341.31
},
{
"text": "Siz eslaysiz: signal kuchsiz bo'lsa ham, SMS qo'ng'iroqdan ko'ra osonroq ketadi.",
"start": 341.542,
"end": 346.495
},
{
"text": "Baland joyda esa signal paydo bo'lishi mumkin.",
"start": 346.699,
"end": 348.885
},
{
"text": "Siz tepalikka chiqasiz.",
"start": 349.117,
"end": 350.391
},
{
"text": "Har qadamda tizzagacha qorga botasiz.",
"start": 350.567,
"end": 352.77
},
{
"text": "Tepada telefonni baland ko'tarasiz.",
"start": 352.978,
"end": 354.831
},
{
"text": "Bitta chiziq!",
"start": 355.016,
"end": 355.867
},
{
"text": "Tez yozasiz: \"Yordam!",
"start": 356.108,
"end": 356.78
},
{
"text": "O'rmonda qolib ketdik.",
"start": 356.964,
"end": 357.494
},
{
"text": "Uch kishimiz.",
"start": 357.736,
"end": 359.62
},
{
"text": "Qishloqqa boradigan qisqa yo'l.\"",
"start": 359.77,
"end": 361.249
},
{
"text": "Yuborish...",
"start": 361.529,
"end": 362.142
},
{
"text": "Aylanadi...",
"start": 362.406,
"end": 363.059
},
{
"text": "Aylanadi...",
"start": 363.352,
"end": 364.029
},
{
"text": "Telefon o'chadi.",
"start": 364.33,
"end": 365.202
},
{
"text": "Xabar ketdimi?",
"start": 365.47,
"end": 366.233
},
{
"text": "Bilmaysiz.",
"start": 366.572,
"end": 367.182
},
{
"text": "Yettinchi kun.",
"start": 367.607,
"end": 368.349
},
{
"text": "Siz endi kutolmaysiz.",
"start": 368.604,
"end": 369.982
},
{
"text": "Kimdir sizni ko'rishi kerak.",
"start": 370.175,
"end": 371.461
},
{
"text": "Siz zaxira g'ildirakni chiqarib, mashinadan uzoqroqqa qo'yasiz.",
"start": 371.671,
"end": 374.912
},
{
"text": "Ostiga quruq shoxlar terasiz.",
"start": 375.085,
"end": 376.753
},
{
"text": "Oxirgi gugurt.",
"start": 376.981,
"end": 377.832
},
{
"text": "Birinchisi o'chadi.",
"start": 378.075,
"end": 378.946
},
{
"text": "Ikkinchisi ham.",
"start": 379.22,
"end": 379.911
},
{
"text": "Uchinchisi...",
"start": 380.193,
"end": 380.851
},
{
"text": "Yonadi!",
"start": 381.085,
"end": 381.6
},
{
"text": "G'ildirak qora tutun chiqarib yona boshlaydi.",
"start": 381.835,
"end": 384.057
},
{
"text": "Qor ustida qop-qora ustun osmonga ko'tariladi.",
"start": 384.272,
"end": 386.945
},
{
"text": "Bir soat o'tadi.",
"start": 387.186,
"end": 388.024
},
{
"text": "Keyin uzoqdan bir tovush eshitiladi.",
"start": 388.252,
"end": 390.267
},
{
"text": "Shamolmi?",
"start": 390.547,
"end": 391.094
},
{
"text": "Yo'q...",
"start": 391.375,
"end": 391.703
},
{
"text": "Motor ovozi!",
"start": 391.966,
"end": 392.774
},
{
"text": "Daraxtlar orasidan qor mototsikli chiqib keladi.",
"start": 392.992,
"end": 395.465
},
{
"text": "Ortidan yana ikkita.",
"start": 395.7,
"end": 396.828
},
{
"text": "Qutqaruvchilar!",
"start": 397.091,
"end": 397.87
},
{
"text": "Ular SMS'ni olishgan va tutunni ko'rib kelishgan ekan.",
"start": 398.128,
"end": 401.304
},
{
"text": "Qutqaruvchi xaritani ko'rsatib bosh chayqaydi: \"Bu yo'l o'n yildan beri yopiq.",
"start": 401.537,
"end": 405.772
},
{
"text": "Eski o'rmon yo'li.",
"start": 405.929,
"end": 406.916
},
{
"text": "Navigatorlar uni haliyam ko'rsatadi...\"",
"start": 407.122,
"end": 409.054
},
{
"text": "Keyin aytgan gapi sizni qotirib qo'yadi: \"Siz qishloqdan atigi uch kilometr narida turgan ekansiz.\"",
"start": 409.288,
"end": 414.812
},
{
"text": "Shifoxonada shifokor aytadi: siz hammasini to'g'ri qilgansiz.",
"start": 415.692,
"end": 419.351
},
{
"text": "Agar siz ham qishda yo'lda qolib ketsangiz, beshta qoidani eslab qoling.",
"start": 419.669,
"end": 424.196
},
{
"text": "Birinchi: mashinadan uzoqqa ketmang.",
"start": 424.604,
"end": 425.987
},
{
"text": "Mashinani topish odamni topishdan osonroq.",
"start": 426.317,
"end": 428.798
},
{
"text": "Ikkinchi: tutun quvurini doim qordan tozalang.",
"start": 429.15,
"end": 432.053
},
{
"text": "Uchinchi: motorni har soatda faqat o'n besh daqiqa yoqing va oynani sal oching.",
"start": 432.437,
"end": 437.339
},
{
"text": "To'rtinchi: qorni yemang, uni eritib iching.",
"start": 437.704,
"end": 440.513
},
{
"text": "Beshinchi: zaryad oz bo'lsa, qo'ng'iroq emas, SMS yuboring va baland joy qidiring.",
"start": 440.863,
"end": 446.459
},
{
"text": "Bu qoidalar bir kun kimningdir hayotini saqlab qolishi mumkin.",
"start": 446.783,
"end": 449.981
},
{
"text": "Shu videoni yaqinlaringizga ham yuboring.",
"start": 450.281,
"end": 452.287
},
{
"text": "Siz yetti kun omon qoldingiz.",
"start": 453.482,
"end": 455.361
},
{
"text": "Is gazidan, sovuqdan, ochlik va bo'rilardan.",
"start": 455.605,
"end": 458.674
},
{
"text": "Lekin bitta savol sizni hali ham qiynaydi: agar o'sha SMS ketmaganida-chi?",
"start": 458.88,
"end": 463.704
},
{
"text": "Siz bu mashinada necha kun chidagan bo'lardingiz?",
"start": 463.986,
"end": 466.553
},
{
"text": "Birinchi bo'lib nima qilgan bo'lardingiz?",
"start": 466.861,
"end": 468.858
},
{
"text": "Izohlarda yozing.",
"start": 469.174,
"end": 470.048
},
{
"text": "Bunday hikoyalar ko'proq bo'lishi uchun obuna bo'ling!",
"start": 470.356,
"end": 473.189
}
]
}